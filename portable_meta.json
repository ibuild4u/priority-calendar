{
  "name": "priority-calendar",
  "version": "1.0.0",
  "entry": "http://localhost:$SHELL_PORT_FRONTEND$/priority-calendar/",
  "processes": [
    {
      "name": "api",
      "cmd": "node",
      "args": ["server.js"],
      "port": "auto",
      "ready_signal": "File write server running on"
    },
    {
      "name": "frontend",
      "cmd": "npm",
      "args": ["run", "dev", "--", "--open=false"],
      "port": "auto",
      "env": { "BROWSER": "none" },
      "ready_signal": "Local:   http://localhost:"
    }
  ],
  "window": {
    "width": 1400,
    "height": 900
  }
}
